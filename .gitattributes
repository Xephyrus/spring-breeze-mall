# 统一 Git 的行尾处理，配合 .editorconfig
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制，不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.sqlite binary

# 锁文件与生成物：不参与 diff 统计
pnpm-lock.yaml -diff
backend/**/target/** -diff
