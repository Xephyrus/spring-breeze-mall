{
  "name": "@spring-breeze/uniapp",
  "version": "4.5.3",
  "private": true,
  "description": "Uni-app mobile client (Vue 3)",
  "engines": {
    "node": ">=24"
  },
  "main": "main.js",
  "scripts": {
    "postinstall": "patch-package && node scripts/patch-mqtt-abort.js",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json --pretty false",
    "lint": "eslint . --max-warnings 260",
    "lint:fix": "eslint . --fix",
    "test": "node scripts/test-lottery-wheel.mjs && node scripts/test-payment-success.mjs && node scripts/test-goods-sku.mjs && node scripts/test-order-evaluation.mjs && node scripts/test-mqtt-app-runtime.js",
    "test:mqtt-app-runtime": "node scripts/test-mqtt-app-runtime.js",
    "test:lottery-wheel": "node scripts/test-lottery-wheel.mjs",
    "test:payment-success": "node scripts/test-payment-success.mjs",
    "test:goods-sku": "node scripts/test-goods-sku.mjs",
    "test:order-evaluation": "node scripts/test-order-evaluation.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/beijing_hongye_huicheng/lilishop-uniapp"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@tencentcloud/chat": "^3.5.5",
    "hls.js": "^1.6.16",
    "mqtt": "5.15.1",
    "sass": "^1.89.2",
    "uview-plus": "3.8.42",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.32",
    "@eslint/js": "^10.0.1",
    "eslint": "^9",
    "eslint-plugin-vue": "^10",
    "globals": "^17.13.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.4",
    "vue-eslint-parser": "^10",
    "vue-tsc": "catalog:"
  }
}
