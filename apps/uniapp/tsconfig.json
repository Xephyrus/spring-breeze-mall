{
  // ============================================================================
  // uniapp 的类型检查配置（**只用于 typecheck / 编辑器，不参与 HBuilderX 构建**）
  //
  // 背景：本项目的构建完全交给 HBuilderX，`@dcloudio/*` 只装了 types，
  // 项目里没有 vue 运行时包（HBuilderX 编译期注入）。因此：
  //   - 不给 uniapp 安装 `vue`（否则可能与 HBuilderX 内置 Vue 混用，
  //     vite.config.js 的 @vue/* alias 正是在防这个）；
  //   - 类型检查只做静态分析，输出 noEmit。
  //
  // strict 起步为 false：项目里 198 个 SFC 早已在写 TS 语法，但从未有过
  // tsc 环节，直接开 strict 会产生大量与本次迁移无关的噪声。先建网、再收紧。
  // ============================================================================
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["@dcloudio/types"],
    "jsx": "preserve"
  },
  "include": ["**/*.ts", "**/*.d.ts", "**/*.vue"],
  "exclude": [
    "node_modules",
    "unpackage",
    "dist",
    "hybrid",
    "uni_modules",
    "js_sdk",
    "scripts",
    "patches",
    "CustomStartPage",
    "CustomStoryboard",
    "static",
    "**/*.config.js"
  ]
}
