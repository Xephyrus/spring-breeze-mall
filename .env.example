# Copy to .env and adjust for your machine (optional helper for docs / scripts).
# Backend reads Spring YAML; edit application-dev.yml or use env overrides below.

# MySQL 9.7 (local)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=lilishop
MYSQL_USER=root
# Never commit the real .env — it is gitignored.
MYSQL_PASSWORD=change-me

# Redis 8.x (local) — leave empty if no requirepass
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Spring profile
SPRING_PROFILES_ACTIVE=dev
